        {
            "id": "OAuth2 token exchange proxy for desktop clients. Handles the server-side\nOAuth2 authorization code flow with PKCE so desktop applications can\nauthenticate with third-party cloud providers without embedding client secrets.",
            "message": "OAuth2 token exchange proxy for desktop clients. Handles the server-side\nOAuth2 authorization code flow with PKCE so desktop applications can\nauthenticate with third-party cloud providers without embedding client secrets.",
            "translation": "Proxy d'échange de jetons OAuth2 pour les clients de bureau. Gère le flux\nd'autorisation OAuth2 côté serveur avec PKCE afin que les applications de\nbureau puissent s'authentifier auprès de fournisseurs cloud tiers sans\nintégrer de secrets client."
        },
        {
            "id": "Usage:",
            "message": "Usage:",
            "translation": "Utilisation :"
        },
        {
            "id": "oauth2-auth-code-proxy --config \u003ccreds.yaml\u003e [options]",
            "message": "oauth2-auth-code-proxy --config \u003ccreds.yaml\u003e [options]",
            "translation": "oauth2-auth-code-proxy --config \u003ccreds.yaml\u003e [options]"
        },
        {
            "id": "Options:",
            "message": "Options:",
            "translation": "Options :"
        },
        {
            "id": "--config \u003cpath\u003e              Credentials YAML file (required)",
            "message": "--config \u003cpath\u003e              Credentials YAML file (required)",
            "translation": "--config \u003cchemin\u003e            Fichier YAML des identifiants (requis)"
        },
        {
            "id": "--port \u003cport\u003e                REST API listen port (default: 80)",
            "message": "--port \u003cport\u003e                REST API listen port (default: 80)",
            "translation": "--port \u003cport\u003e                Port d'écoute API REST (défaut : 80)"
        },
        {
            "id": "--mwlegacy-port \u003cport\u003e       Legacy API listen port (default: 30045)",
            "message": "--mwlegacy-port \u003cport\u003e       Legacy API listen port (default: 30045)",
            "translation": "--mwlegacy-port \u003cport\u003e       Port d'écoute API legacy (défaut : 30045)"
        },
        {
            "id": "--mwlegacy-enabled=false     Disable legacy API listener",
            "message": "--mwlegacy-enabled=false     Disable legacy API listener",
            "translation": "--mwlegacy-enabled=false     Désactiver l'écouteur API legacy"
        },
        {
            "id": "--tls-cert \u003cpath\u003e            TLS certificate for HTTPS serving",
            "message": "--tls-cert \u003cpath\u003e            TLS certificate for HTTPS serving",
            "translation": "--tls-cert \u003cchemin\u003e          Certificat TLS pour le service HTTPS"
        },
        {
            "id": "--tls-key \u003cpath\u003e             TLS private key for HTTPS serving",
            "message": "--tls-key \u003cpath\u003e             TLS private key for HTTPS serving",
            "translation": "--tls-key \u003cchemin\u003e           Clé privée TLS pour le service HTTPS"
        },
        {
            "id": "--tls-insecure-skip-verify   Skip TLS verify on outbound calls",
            "message": "--tls-insecure-skip-verify   Skip TLS verify on outbound calls",
            "translation": "--tls-insecure-skip-verify   Ignorer la vérification TLS sur les appels sortants"
        },
        {
            "id": "--legacy                     Show legacy configuration options",
            "message": "--legacy                     Show legacy configuration options",
            "translation": "--legacy                     Afficher les options de configuration legacy"
        },
        {
