            "message": "Environment Variables:",
            "translation": "Variables d'environnement :"
        },
        {
            "id": "OAUTH_CREDS_FILE             Credentials YAML file path",
            "message": "OAUTH_CREDS_FILE             Credentials YAML file path",
            "translation": "OAUTH_CREDS_FILE             Chemin du fichier YAML des identifiants"
        },
        {
            "id": "OAUTH_PORT                   REST API port (default: 80)",
            "message": "OAUTH_PORT                   REST API port (default: 80)",
            "translation": "OAUTH_PORT                   Port API REST (défaut : 80)"
        },
        {
            "id": "OAUTH_MWLEGACY_PORT          Legacy API port (default: 30045)",
            "message": "OAUTH_MWLEGACY_PORT          Legacy API port (default: 30045)",
            "translation": "OAUTH_MWLEGACY_PORT          Port API legacy (défaut : 30045)"
        },
        {
            "id": "OAUTH_MWLEGACY_ENABLED       Set false to disable legacy API",
            "message": "OAUTH_MWLEGACY_ENABLED       Set false to disable legacy API",
            "translation": "OAUTH_MWLEGACY_ENABLED       Mettre à false pour désactiver l'API legacy"
        },
        {
            "id": "OAUTH_TLS_CERT_FILE          TLS certificate path",
            "message": "OAUTH_TLS_CERT_FILE          TLS certificate path",
            "translation": "OAUTH_TLS_CERT_FILE          Chemin du certificat TLS"
        },
        {
            "id": "OAUTH_TLS_KEY_FILE           TLS private key path",
