            "message": "LANG                         Locale for help output (en-US, fr-FR)",
            "translation": "LANG                         Langue de l'aide (en-US, fr-FR)"
        },
        {
            "id": "The legacy API listener is enabled by default on port 30045.",
            "message": "The legacy API listener is enabled by default on port 30045.",
            "translation": "L'écouteur API legacy est activé par défaut sur le port 30045."
        },
        {
            "id": "Use --mwlegacy-enabled=false to disable, or --legacy for legacy options.",
            "message": "Use --mwlegacy-enabled=false to disable, or --legacy for legacy options.",
            "translation": "Utilisez --mwlegacy-enabled=false pour désactiver, ou --legacy pour les options legacy."
        },
        {
            "id": "Legacy Settings (--set):",
            "message": "Legacy Settings (--set):",
            "translation": "Paramètres legacy (--set) :"
        },
        {
            "id": "Settings prefixed with oas. or mito. are deprecated but supported",
            "message": "Settings prefixed with oas. or mito. are deprecated but supported",
            "translation": "Les paramètres préfixés par oas. ou mito. sont obsolètes mais supportés"
        },
        {
            "id": "for backward compatibility.",
            "message": "for backward compatibility.",
            "translation": "pour la rétrocompatibilité."
        },
