{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push *)",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-push-checks.sh",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
