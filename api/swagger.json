    "info": {
        "contact": {
            "name": "MathWorks Technical Support",
            "url": "https://www.mathworks.com/support/contact_us.html"
        },
        "description": "OAuth2 token exchange proxy for MATLAB and MathWorks desktop clients.\nHandles server-side OAuth2 authorization code flow with PKCE so desktop\napplications authenticate with third-party cloud providers without embedding\nclient secrets.",
        "license": {
            "name": "MathWorks Cloud Reference Architecture License",
            "url": "https://github.com/mathworks-ref-arch/container-images/oauth2-auth-code-proxy/blob/main/LICENSE.md"
        },
        "title": "OAuth2 Token Proxy API",
        "version": "1.0"
    },
    "externalDocs": {
        "description": "",
        "url": ""
    },
    "paths": {
        "/admin/alive/{echo}": {
            "get": {
                "description": "Returns service version, build info, and connectivity diagnostics for all\nconfigured OAuth2 provider endpoints (auth, token, revoke, testing URLs).",
                "parameters": [
                    {
                        "description": "Echo string returned in response",
                        "in": "path",
                        "name": "echo",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/admin.AliveResponse"
                                }
                            }
                        },
                        "description": "OK"
                    }
                },
                "summary": "Health check",
                "tags": [
                    "admin"
                ]
            }
        },
        "/api": {
            "post": {
                "description": "Single endpoint that dispatches on the \"mwtype\" field in the JSON body.\nSupported types: oauth/InitRequest, oauth/TokenRequest, oauth/RefreshRequest, oauth/ListRequest.",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object"
                            }
                        },
                        "text/plain": {
                            "schema": {
                                "title": "body",
                                "type": "object"
                            }
                        }
                    },
                    "description": "JSON envelope with mwtype discriminator",
                    "required": true
                },
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "oneOf": [
                                        {
                                            "$ref": "#/components/schemas/mwlegacy.InitResponse"
                                        },
                                        {
                                            "$ref": "#/components/schemas/mwlegacy.TokenResponse"
                                        },
                                        {
                                            "$ref": "#/components/schemas/mwlegacy.RefreshResponse"
                                        },
                                        {
                                            "$ref": "#/components/schemas/mwlegacy.ListResponse"
                                        },
                                        {
                                            "$ref": "#/components/schemas/domain.FaultResponse"
                                        }
                                    ]
                                }
                            }
                        },
                        "description": "Fault on invalid input or unknown mwtype"
                    }
                },
                "summary": "Dispatch OAuth2 operation",
                "tags": [
                    "oauth"
                ]
            }
        },
        "/apps": {
            "get": {
                "description": "Returns all configured OAuth applications with public fields only (no secrets).",
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/v1.AppsResponse"
                                }
                            }
                        },
                        "description": "OK"
                    }
                },
                "summary": "List configured apps",
                "tags": [
                    "v1"
                ]
            }
        },
        "/authorize": {
            "post": {
                "description": "Creates an OAuth2 authorization URL with PKCE code challenge for the specified app.",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "oneOf": [
                                    {
                                        "type": "object"
                                    },
                                    {
                                        "$ref": "#/components/schemas/v1.AuthorizeRequest",
                                        "summary": "body",
                                        "description": "Authorization request"
                                    }
                                ]
                            }
                        }
                    },
                    "description": "Authorization request",
                    "required": true
                },
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/v1.AuthorizeResponse"
                                }
                            }
                        },
                        "description": "OK"
                    },
                    "400": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/v1.ErrorResponse"
                                }
                            }
                        },
                        "description": "Bad Request"
                    }
                },
                "summary": "Generate authorization URL",
                "tags": [
                    "v1"
                ]
            }
        },
        "/redirect": {
            "get": {
                "description": "Receives authorization code and state from the OAuth2 provider,\nthen redirects the browser back to the desktop client's local HTTP listener.",
                "parameters": [
                    {
                        "description": "Authorization code from OAuth2 provider",
                        "in": "query",
                        "name": "code",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "description": "State containing appID and client redirect URL (format: appID-redirectURL)",
                        "in": "query",
                        "name": "state",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "text/html": {
                                "schema": {
                                    "oneOf": [
                                        {
                                            "type": "string"
                                        },
                                        {
                                            "$ref": "#/components/schemas/domain.FaultResponse"
                                        }
                                    ]
                                }
                            }
                        },
                        "description": "Fault on missing or invalid parameters"
                    }
                },
                "summary": "OAuth2 redirect callback",
                "tags": [
                    "oauth"
                ]
            }
        },
        "/token": {
            "post": {
                "description": "Exchange an authorization code for tokens (grant_type=authorization_code)\nor refresh an access token (grant_type=refresh_token).",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "oneOf": [
                                    {
                                        "type": "object"
                                    },
                                    {
                                        "$ref": "#/components/schemas/v1.TokenRequestBody",
                                        "summary": "body",
                                        "description": "Token request"
                                    }
                                ]
                            }
                        }
                    },
                    "description": "Token request",
                    "required": true
                },
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/v1.TokenResponseBody"
                                }
                            }
                        },
                        "description": "OK"
                    },
                    "400": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/v1.ErrorResponse"
                                }
                            }
                        },
                        "description": "Bad Request"
                    }
                },
                "summary": "Token exchange",
                "tags": [
                    "v1"
                ]
            }
        }
    },
    "openapi": "3.1.0"
}